# Optional. The boiler key normally lives in guntacontrol.yaml (device.writeKey).
# As a fallback, if that field is left empty, this environment variable is used
# instead — handy for Docker if you'd rather not put the key in the YAML file.
# Copy to ".env" next to docker-compose.yml and uncomment the mapping there.
GUNTAMATIC_WRITE_KEY=22610AC9XXXXXXXXXXXXXXXXXXXXXXXXXXXX
